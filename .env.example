# ============================================================
# LIU WhatsApp AI Assistant — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ----- Server --------------------------------------------------
NODE_ENV=development
PORT=3000
LOG_LEVEL=info
# Set to 'true' for pretty, colorized logs in local development
LOG_PRETTY=true

# ----- Meta / WhatsApp Cloud API --------------------------------
# Obtain from: https://developers.facebook.com/apps/
# Your permanent system user access token
WHATSAPP_TOKEN=your_whatsapp_token_here

# The Phone Number ID (not the phone number itself)
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# A secret string YOU choose — used for webhook verification
# Must match what you set in Meta App Dashboard > Webhooks
WHATSAPP_VERIFY_TOKEN=liu_dev_verify

# Your Meta App Secret (found in App Dashboard > Settings > Basic)
META_APP_SECRET=your_meta_app_secret_here

# ----- OpenAI ---------------------------------------------------
# Obtain from: https://platform.openai.com/api-keys
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_MODEL=gpt-4o-mini
OPENAI_MAX_TOKENS=512

# ----- Feature Flags (optional overrides) -----------------------
# Set to 'true'  to force mock adapters (no real API calls)
# Set to 'false' to force real adapters (credentials required)
# Leave empty   to auto-detect based on whether credentials are set
USE_MOCK_AI=
USE_MOCK_WHATSAPP=
